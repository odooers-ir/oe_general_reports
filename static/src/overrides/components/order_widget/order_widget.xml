<t t-name="oe_general_reports.OrderWidget" t-inherit="point_of_sale.OrderWidget" t-inherit-mode="extension">
    <xpath expr="//t" position="replace">
        <!-- <main> -->
        <t t-if="props.lines?.length">
            <div t-ref="scrollable" class="order-container bg-view overflow-y-auto flex-grow-1 d-flex flex-column text-start">
                <table width="100%">
                    <colgroup>
                        <col span="1" style="width: 50%;" />
                        <col span="1" style="width: 20%;" />
                        <col span="1" style="width: 10%;" />
                        <col span="1" style="width: 20%;" />
                    </colgroup>
                    <thead class="text-center bg-light-gray">
                        <tr>
                            <th>نام آیتم</th>
                            <th>فی (ریال)</th>
                            <th>تعداد</th>
                            <th>قیمت کل</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="props.lines" t-as="line" t-key="line_index">
                            <t t-slot="default" line="line"/>
                            </t>
                    </tbody>
                    <tfoot t-if="props.total or props.tax" class="order-summary w-100 py-2 px-3 bg-100 text-end fw-bolder fs-2 lh-sm">
                        <tr>
                            <th colspan="3" class="text-end">تعداد آیتم</th>
                            <th class="persian-digits">1</th>
                        </tr>
                        <tr>
                            <th colspan="3" class="text-end">جمع کل (ریال)</th>
                            <th class="persian-digits">3/875/000</th>
                        </tr>
                        <tr>
                            <th colspan="3" class="text-end">میزان تخفیف کلی (ریال)</th>
                            <th class="persian-digits">0</th>
                        </tr>
                        <tr>
                            <th colspan="3" class="text-end">مالیات بر ارزش افزوده (ریال)</th>
                            <th class="persian-digits">387/500</th>
                        </tr>
                        <tr class="bg-light-gray border-top border-dark">
                            <th colspan="3" class="text-end">مبلغ قابل پرداخت (ریال)</th>
                            <th class="persian-digits">4/262/500</th>
                        </tr>
                    </tfoot>
                </table>
                <t t-slot="details"/>
            </div>
        </t>
        <t t-else="">
            <CenteredIcon icon="'fa-shopping-cart fa-4x'" text="emptyCartText()"/>
            <t t-slot="details"/>
        </t>
        <!-- </main> -->
    </xpath>
</t>