<t t-name="oe_general_reports.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
    <xpath expr="//li" position="replace">
        <tr class="orderline p-2 lh-sm cursor-pointer" t-attf-class="{{ line.comboParent ? 'border-start border-3 ms-4' : '' }}" t-att-class="props.class">
            <td class="text-right">
                <span class="text-wrap" t-esc="line.productName"/>
                <t t-slot="product-name"/>
            </td>
            <td class="text-center persian-digits">
                <t t-if="line.price === 'free'">
                        Free
                    </t>
                <t t-else="" t-esc="line.price"/>
            </td>
            <td class="text-center persian-digits">
                <t t-esc="line.qty"/>
            </td>
            <td class="text-center persian-digits">
                <t t-esc="line.price * line.qty"/>
            </td>
        </tr>
    </xpath>
</t>